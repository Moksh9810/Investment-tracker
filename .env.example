# Bahi-Khata Environment Variables
# Copy this file to .env and fill in your actual values
# DO NOT commit .env file to version control!

# ============================================
# SUPABASE CONFIGURATION
# ============================================
# Get these from: https://app.supabase.com/project/[your-project]/settings/api

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ============================================
# API CONFIGURATION
# ============================================
# URL to your API backend (Vercel, AWS Lambda, etc)

VITE_API_URL=http://localhost:3000/api

# ============================================
# APP CONFIGURATION
# ============================================
# Application name and version

VITE_APP_NAME=Bahi-Khata
VITE_APP_VERSION=1.0.0

# ============================================
# FEATURE FLAGS
# ============================================
# Enable/disable features

VITE_FEATURE_STOCK_TRACKING=true
VITE_FEATURE_MUTUAL_FUNDS=true
VITE_FEATURE_BONDS=true
VITE_FEATURE_PREMIUM=true
VITE_FEATURE_REAL_TIME=false

# ============================================
# ENVIRONMENT
# ============================================
# Production or development

VITE_ENVIRONMENT=development

# ============================================
# DEBUG MODE
# ============================================
# Enable debug logging

VITE_DEBUG=true
